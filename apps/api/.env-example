SERVER__DOMAIN=localhost:8081
SERVER__HOST=localhost
SERVER__PORT=8081
SERVER__BASE_PATH=/api
# Fastify rate limits (per IP) — defaults shown
# SERVER__RATE_LIMIT__MAX=1000
# SERVER__RATE_LIMIT__AUTH_MAX=20
# Behind a reverse proxy, trust X-Forwarded-For so that request.ip is the real
# client — otherwise the per-IP rate limit is one bucket shared by everyone and
# the audit log records the proxy as the origin of every sign-in. Prefer a hop
# count or a CIDR list over `true`, which lets clients forge their own address.
# SERVER__TRUST_PROXY=1

# Database (the db container is started by `make dev`)
DB__URL=postgresql://admin:admin@localhost:5432/template-monorepo-ts?schema=public
DB__PRISMA_SCHEMA_PATH=./prisma/schema.prisma
# Optional read replica (e.g. CNPG -ro service) — pure reads are routed there
# DB__READ_URL=

# Auth
AUTH__SECRET=change-me-in-production-use-256-bit-random
AUTH__BASE_URL=http://localhost:8081
AUTH__TRUSTED_ORIGINS=http://localhost:3000
# Redis-backed sessions, caches and rate-limit storage (started by `make dev`)
AUTH__REDIS__URL=redis://localhost:6379
# BetterAuth internal rate limiter — defaults shown
# AUTH__RATE_LIMIT__ENABLED=true
# AUTH__RATE_LIMIT__WINDOW=10
# AUTH__RATE_LIMIT__MAX=100

# OIDC federation — bundled Keycloak realm (demo logins: admin/admin, user/user).
# Start it first: docker compose -f docker/docker-compose.dev.yml up keycloak -d
OIDC__ENABLED=false
OIDC__CLIENT_ID=template-monorepo-ts
OIDC__CLIENT_SECRET=change-me
OIDC__ISSUER=http://localhost:8084/realms/template-monorepo-ts
OIDC__PUBLIC_URL=
# Sync Keycloak realm roles into the app role field (realm role "admin" → platform admin)
OIDC__MAP_ROLES=true
# Sync Keycloak group memberships as roles and org memberships
# ("/engineering" → member of org "engineering", "/engineering/admin" → admin)
OIDC__MAP_GROUPS=true
# Map org-scoped realm roles ("org-<role>:<org-slug>", e.g. "org-admin:engineering")
OIDC__MAP_ORG_ROLES=true
OIDC__ORG_ROLE__PREFIX=org-
OIDC__ORG_ROLE__DEFAULT=member

# Initial admin user (optional - created on first startup if set)
BOOTSTRAP__EMAIL=admin@example.com
BOOTSTRAP__PASSWORD=admin

# Modules (toggle features on/off)
MODULES__AUTH=true
MODULES__AUDIT__ENABLED=true

# Platform settings — values set here are LOCKED in the admin UI.
# Leave unset to manage them live from the admin settings page instead.
PLATFORM__DOCUMENTATION_URL=http://localhost:8082
# PLATFORM__APP_NAME=My Platform
# PLATFORM__ENABLE_REGISTRATION=true
# PLATFORM__ALLOW_ORGANIZATION_CREATION=true
# PLATFORM__MAINTENANCE_MODE=false
# PLATFORM__MAX_ORGANIZATIONS_PER_USER=
# PLATFORM__MAX_PROJECTS_PER_ORG=
# Auto-purge audit entries older than N days (0 = keep forever)
# PLATFORM__AUDIT_RETENTION_DAYS=90

# Observability — SDK-standard OTEL_* names, read by the OpenTelemetry SDK
# itself, so these are NOT part of the prefixed config schema above (no `__`,
# no config-file section). Any other standard variable works too, e.g.
# OTEL_RESOURCE_ATTRIBUTES or OTEL_EXPORTER_OTLP_HEADERS.
# `make dev` starts no collector, so the SDK exports into the void and still
# binds the Prometheus port — uncomment the first line to switch it off, or
# start one with: docker compose -f docker/docker-compose.dev.yml up otel-collector -d
# OTEL_SDK_DISABLED=true
# OTEL_SERVICE_NAME=api
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_METRICS_PORT=9000

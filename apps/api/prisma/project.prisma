// ---------------------------------------------------------------------------
// project.prisma — application domain model for the projects resource
// ---------------------------------------------------------------------------

model Project {
  id             String          @id @default(uuid())
  name           String
  description    String?
  ownerId        String
  organizationId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  members        ProjectMember[]
  owner          User            @relation(fields: [ownerId], references: [id])
  // Deleting an organization takes its projects with it, the way it already
  // takes members and invitations. Without the constraint the rows survived
  // pointing at an organization that no longer existed — invisible in every
  // org-scoped list, but still counting against quotas.
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Machine identities that act on this project's behalf. Cascades, so a
  // deleted project cannot leave a credential behind — the service account
  // goes, and `apikey.referenceId` takes its keys with it.
  serviceAccounts User[]         @relation("ProjectServiceAccounts")

  @@index([ownerId])
  @@index([organizationId])
  @@map("project")
}

// ---------------------------------------------------------------------------
// Project members — collaborators on a project (GitHub-like)
// ---------------------------------------------------------------------------

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      String   @default("member") // owner | admin | member | viewer
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_member")
}
